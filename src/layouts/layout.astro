---
import Footer from "../components/Footer.astro";
import {
  THEME_STORAGE_KEY,
  THEME_DARK_CLASS,
  THEME_MEDIA_QUERY,
} from "../services/theme";
import "../styles/global.css";

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const themeConfig = {
  storageKey: THEME_STORAGE_KEY,
  darkClass: THEME_DARK_CLASS,
  mediaQuery: THEME_MEDIA_QUERY,
};

interface Props {
  title?: string;
  description?: string;
  robots?: string;
}

const {
  title = "José Sánchez Aranda — Frontend Engineer",
  description = "José Sánchez Aranda, Frontend Engineer specializing in Angular, TypeScript, and modern web technologies. Explore my portfolio, experience, and projects.",
  robots = "index, follow",
} = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/icon.svg" />
    <link rel="apple-touch-icon" href="/icon-192.png" />
    <meta name="theme-color" content="#1e3a5f" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="author" content="José Sánchez Aranda" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <title>{title}</title>

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL("/icon-512.png", Astro.site)} />
    <meta property="og:site_name" content="José Sánchez Aranda" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL("/icon-512.png", Astro.site)} />
    <meta name="twitter:creator" content="@JoseSaranda" />

    <!-- JSON-LD Structured Data -->
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Person",
        name: "José Sánchez Aranda",
        url: "https://josesaranda.es",
        jobTitle: "Frontend Engineer",
        sameAs: [
          "https://www.linkedin.com/in/josesaranda/",
          "https://x.com/JoseSaranda",
          "https://github.com/josesaranda",
        ],
      })}
    />

    <!-- Preconnect to external domains -->
    <link rel="dns-prefetch" href="https://www.linkedin.com" />
    <link rel="dns-prefetch" href="https://x.com" />
    <link rel="dns-prefetch" href="https://github.com" />

    <link rel="manifest" href="/manifest.json" />
    <script define:vars={themeConfig} is:inline>
      (function () {
        const t = localStorage.getItem(storageKey);
        if (t === "dark") {
          document.documentElement.classList.add(darkClass);
        } else if (t === "light") {
          document.documentElement.classList.remove(darkClass);
        } else if (window.matchMedia(mediaQuery).matches) {
          document.documentElement.classList.add(darkClass);
        }
      })();
    </script>
  </head>
  <body
    class="bg-white dark:bg-gray-950 text-gray-800 dark:text-gray-100 transition-colors duration-300"
  >
    <slot />
    <Footer />
  </body>
</html>
<script>
  import { toggle, watchSystemPreference } from "../services/theme";

  if ("serviceWorker" in navigator) {
    window.addEventListener("load", () => {
      navigator.serviceWorker.register("/sw.js");
    });
  }

  document.querySelectorAll(".theme-toggle").forEach((btn) => {
    btn.addEventListener("click", () => toggle());
  });

  watchSystemPreference();
</script>
