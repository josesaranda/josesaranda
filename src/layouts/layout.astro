---
import Footer from "../components/Footer.astro";
import "../styles/global.css";

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/icon.svg" />
    <link rel="apple-touch-icon" href="/icon-192.png" />
    <meta name="theme-color" content="#1e3a5f" />
    <meta name="viewport" content="width=device-width" />
    <meta name="author" content="José Sánchez Aranda" />
    <meta
      name="description"
      content="José Sánchez Aranda webpage, a portfolio and CV"
    />
    <meta
      name="keywords"
      content="josesaranda, Software, Engineer, JavaScript, Typescript, Astro, Github"
    />
    <title>josesaranda - Welcome</title>
    <link rel="manifest" href="/manifest.json" />
  </head>
  <body class="bg-white">
    <slot />
    <Footer />
  </body>
</html>
<script>
  if ("serviceWorker" in navigator) {
    window.addEventListener("load", () => {
      navigator.serviceWorker.register("/sw.js");
    });
  }
</script>
