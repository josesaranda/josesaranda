---
import Divider from "../components/Divider.astro";
import Experience from "../components/Experience.astro";
import Nav from "../components/Nav.astro";
import Project from "../components/Project.astro";
import Social from "../components/Social.astro";
import Layout from "../layouts/layout.astro";
import { experiences } from "../data/experience";
import { projects } from "../data/projects";
import { socialLinks } from "../data/social";
---

<Layout>
  <Nav />
  <main class="page-enter">
    <section
      id="about"
      class="fade-target max-w-screen-2xl mx-auto px-4 pt-32 md:px-16 lg:pt-64 py-16 lg:py-32"
    >
      <h1 class="text-center lg:text-left text-5xl lg:text-8xl font-serif mb-2">
        <span class="text-gray-500 dark:text-gray-400">I'm</span>
        <span id="typewriter" aria-live="polite"></span><span
          id="typewriter-cursor"
          aria-hidden="true"
          class="inline-block w-[3px] lg:w-[6px] ml-1 bg-gray-800 dark:bg-white animate-blink align-middle"
        ></span>
      </h1>
    </section>
    <section
      class="fade-target max-w-screen-2xl mx-auto px-4 md:px-16 pt-0 lg:pt-32 pb-16 lg:py-32 text-center lg:text-left"
    >
      <p
        class="text-gray-800 dark:text-gray-100 text-3xl lg:text-6xl font-sans lg:!leading-tight mb-6"
      >
        A FrontEnd Engineer so seasoned, I remember when the internet was just a
        rumor! It's not a joke!
      </p>
      <p
        class="text-gray-600 dark:text-gray-400 text-2xl lg:text-5xl font-serif lg:!leading-snug italic"
      >
        Last decades I've been working with Angular, Html, Css, Sass, Tailwind,
        JavaScript, Typescript and many other great web technologies
      </p>
    </section>
    <Divider />
    <section
      class="fade-target max-w-screen-2xl mx-auto px-4 md:px-16 lg:pt-16 py-16 lg:py-32"
    >
      <h2
        class="text-gray-800 dark:text-gray-100 text-3xl lg:text-6xl font-sans lg:!leading-tight mb-6"
      >
        Currently experimenting with Agents, AI, and other futuristic tech.
        Trying to stay ahead of the robots!
      </h2>
      <p
        class="text-gray-600 dark:text-gray-400 text-2xl lg:text-5xl font-serif lg:!leading-snug italic"
      >
        Also, leveling up my gaming skills. Because saving the world can wait
        until after this boss fight.
      </p>
    </section>
    <section
      id="experience"
      class="section-band border-y border-gray-100 bg-gray-50 dark:border-gray-800 dark:bg-gray-900/50"
    >
      <div class="max-w-screen-2xl mx-auto px-4 md:px-16 py-16 lg:py-32">
        <p class="section-kicker">01 <span>/</span> Experience</p>
        <h2
          class="fade-target text-gray-800 dark:text-gray-100 text-3xl lg:text-6xl font-sans lg:!leading-tight mb-6"
        >
          I've worked for some amazing companies, and by amazing, I mean they
          tolerated my coffee addiction and bad puns. Check out my work below!
        </h2>
      </div>
      {experiences.map((exp) => <Experience {...exp} />)}
    </section>
    <section
      id="projects"
      class="section-band border-b border-blue-100 bg-blue-50/60 dark:border-blue-900/40 dark:bg-blue-950/20"
    >
      <div class="max-w-screen-2xl mx-auto px-4 md:px-16 py-16 lg:py-32">
        <p class="section-kicker">02 <span>/</span> Projects</p>
        <h2
          class="fade-target text-gray-800 dark:text-gray-100 text-3xl lg:text-6xl font-sans lg:!leading-tight mb-6"
        >
          Also, I'd like to mention the projects I've worked on as a
          collaborator. Because, you know, sharing is caring!
        </h2>
        <p
          class="fade-target text-gray-600 dark:text-gray-400 text-2xl lg:text-5xl font-serif lg:!leading-snug italic"
        >
          Yay Yay Events trusted me to make their events' website sparkle. Check
          out the landings I've crafted for them. Spoiler: they're fabulous!
        </p>
      </div>
      {projects.map((proj) => <Project {...proj} />)}
    </section>
    <section
      id="social"
      class="section-band border-b border-gray-100 bg-gray-50 dark:border-gray-800 dark:bg-gray-900/50"
    >
      <div class="max-w-screen-2xl mx-auto px-4 md:px-16 py-16 lg:py-32">
        <p class="section-kicker">03 <span>/</span> Connect</p>
        <h2
          class="text-gray-800 dark:text-gray-100 text-3xl lg:text-6xl font-sans lg:!leading-tight mb-6"
        >
          Follow me in social media networks
        </h2>
        <p
          class="text-gray-600 dark:text-gray-400 text-2xl lg:text-5xl font-serif lg:!leading-snug italic mb-12 lg:mb-16"
        >
          Cause having a stalker is creepy, but having a follower is flattering!
        </p>
        <div
          class="grid grid-cols-1 sm:grid-cols-3 gap-3 lg:grid-cols-3 lg:gap-6"
        >
          {socialLinks.map((social) => <Social {...social} />)}
        </div>
      </div>
    </section>
  </main>
</Layout>
<script>
  const isReducedMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  if (!isReducedMotion) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("fade-in");
          }

          if (!entry.isIntersecting) {
            entry.target.classList.remove("fade-in");
          }
        });
      },
      { threshold: 0.1 },
    );

    document.querySelectorAll(".fade-target").forEach((el) => {
      observer.observe(el);
    });
  }

  const TYPEWRITER_TEXT = "José Sánchez Aranda";
  const TYPEWRITER_SPEED_MS = 70;
  const TYPEWRITER_START_DELAY_MS = 600;
  const CURSOR_HIDE_DELAY_MS = 1500;

  const typewriterEl = document.getElementById("typewriter");
  const cursorEl = document.getElementById("typewriter-cursor");
  let index = 0;

  function type() {
    if (!typewriterEl || !cursorEl) return;

    if (isReducedMotion) {
      typewriterEl.textContent = TYPEWRITER_TEXT;
      cursorEl.remove();
      return;
    }

    if (index < TYPEWRITER_TEXT.length) {
      typewriterEl.textContent += TYPEWRITER_TEXT.charAt(index);
      index++;
      setTimeout(type, TYPEWRITER_SPEED_MS);
    } else {
      setTimeout(() => cursorEl.classList.add("hidden"), CURSOR_HIDE_DELAY_MS);
    }
  }

  setTimeout(type, TYPEWRITER_START_DELAY_MS);
</script>
<style is:global>
  @keyframes blink {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0;
    }
  }

  .animate-blink {
    animation: blink 1s step-end infinite;
    height: 0.85em;
  }

  .fade-in {
    opacity: 1 !important;
    transition: opacity 0.3s ease-in-out;
  }

  .page-enter {
    transform-origin: top center;
    animation: page-zoom-out 1200ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  @keyframes page-zoom-out {
    from {
      opacity: 0;
      filter: blur(24px);
      transform: scale(1.35);
    }
    to {
      opacity: 1;
      filter: blur(0);
      transform: scale(1);
    }
  }

  .nav-link {
    position: relative;
  }

  .nav-link::after {
    content: "";
    position: absolute;
    bottom: -8px;
    left: 50%;
    width: 5px;
    height: 5px;
    border-radius: 9999px;
    background-color: #1f2937;
    transform: translateX(-50%) scale(0);
    transform-origin: center;
    transition: transform 0.3s ease;
  }

  .dark .nav-link::after {
    background-color: #f3f4f6;
  }

  .nav-link.active-nav::after {
    transform: translateX(-50%) scale(1);
  }

  .nav-link.active-nav,
  .mobile-nav-link.active-nav {
    color: #1f2937;
  }

  .dark .nav-link.active-nav,
  .dark .mobile-nav-link.active-nav {
    color: #f3f4f6;
  }

  .fade-target {
    opacity: 0;
  }

  .section-band {
    position: relative;
    isolation: isolate;
  }

  .section-kicker {
    color: #1e3a5f;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    margin-bottom: 1.5rem;
    text-transform: uppercase;
  }

  .section-kicker span {
    color: #9ca3af;
    margin: 0 0.35rem;
  }

  .dark .section-kicker {
    color: #93c5fd;
  }

  @media (prefers-reduced-motion: reduce) {
    .page-enter {
      animation: none;
    }

    .fade-target {
      opacity: 1;
    }
  }

  html {
    scroll-behavior: smooth;
  }

  [id] {
    scroll-margin-top: 4rem;
  }

  @media (min-width: 1024px) {
    [id] {
      scroll-margin-top: 5rem;
    }
  }
</style>
