---
import CardLink from "./CardLink.astro";

interface Props {
  company: string;
  period: string;
  role: string;
  description: string;
  technologies: string[];
  link: string;
}

const { company, period, role, description, technologies, link } = Astro.props;
---

<CardLink link={link} ariaLabel={`${role} at ${company}: ${description}`}>
  <div class="flex flex-col lg:flex-row lg:items-baseline lg:gap-6 mb-4">
    <h3
      class="text-gray-800 dark:text-white text-2xl lg:text-4xl font-serif leading-tight group-hover:text-blue-900 dark:group-hover:text-blue-400 transition-colors duration-300"
    >
      {company}
    </h3>
    <span
      class="text-gray-400 dark:text-gray-500 text-base lg:text-lg font-sans mt-1 lg:mt-0"
    >
      {period}
    </span>
  </div>
  <p
    class="text-gray-600 dark:text-gray-400 text-sm lg:text-base font-sans !leading-snug mb-4"
  >
    {role}
  </p>
  <p
    class="text-gray-800 dark:text-gray-200 text-base lg:text-lg font-sans leading-relaxed mb-5"
  >
    {description}
  </p>
  <ul class="flex flex-wrap gap-2">
    {
      technologies.map((tech: string) => (
        <li class="text-gray-500 dark:text-gray-400 group-hover:text-gray-700 dark:group-hover:text-gray-200 text-xs lg:text-sm font-sans bg-gray-100 dark:bg-gray-800 group-hover:bg-blue-50 dark:group-hover:bg-blue-900/30 px-2.5 py-1 rounded transition-colors duration-300">
          {tech}
        </li>
      ))
    }
  </ul>
</CardLink>
