---
interface Props {
  title: string;
  link: string;
  icon: "x" | "linkedin" | "github";
}

const { title, link, icon } = Astro.props;

const icons: Record<string, string> = {
  x: '<path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>',
  linkedin:
    '<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>',
  github:
    '<path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.919.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>',
};

const iconColors: Record<string, string> = {
  x: "text-gray-900 dark:text-white",
  linkedin: "text-[#0a66c2]",
  github: "text-gray-900 dark:text-white",
};
---

<a
  href={link}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={`Visit ${title} profile of José Sánchez Aranda`}
  class="group flex min-h-0 flex-row items-center gap-4 rounded-xl border border-gray-200 bg-white px-4 py-3 transition-all duration-500 ease-in-out hover:-translate-y-1 hover:border-blue-900 hover:bg-blue-50 hover:shadow-md dark:border-gray-700 dark:bg-gray-950 dark:hover:border-blue-400 dark:hover:bg-gray-900 motion-reduce:transition-none motion-reduce:hover:translate-y-0 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-blue-700 dark:focus-visible:outline-blue-400 md:px-5 md:py-4 lg:min-h-48 lg:flex-col lg:items-stretch lg:justify-between lg:gap-0 lg:rounded-2xl lg:p-6"
>
  <div
    class="flex w-14 shrink-0 items-center justify-between gap-1 lg:w-full lg:items-start lg:gap-0"
  >
    <div
      class="flex h-10 w-10 items-center justify-center rounded-lg bg-gray-100 dark:bg-gray-800 lg:h-12 lg:w-12 lg:rounded-xl"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="currentColor"
        class={`h-5 w-5 ${iconColors[icon]} lg:h-6 lg:w-6`}
        aria-hidden="true"
      >
        <Fragment set:html={icons[icon]} />
      </svg>
    </div>
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.75"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="hidden h-4 w-4 text-gray-400 dark:text-gray-500 lg:block lg:h-5 lg:w-5"
      aria-hidden="true"
    >
      <path d="M7 17 17 7"></path>
      <path d="M7 7h10v10"></path>
    </svg>
  </div>
  <div
    class="flex min-w-0 flex-1 items-center justify-between gap-3 lg:block lg:flex-none"
  >
    <h3
      class="truncate font-serif text-lg leading-tight text-gray-900 transition-colors duration-500 ease-in-out group-hover:text-blue-900 dark:text-gray-100 dark:group-hover:text-blue-300 motion-reduce:transition-none lg:text-2xl"
    >
      {title}
    </h3>
    <p
      class="block shrink-0 whitespace-nowrap font-sans text-xs font-medium text-gray-500 dark:text-gray-400 sm:hidden lg:mt-2 lg:block lg:text-sm"
    >
      Visit profile
    </p>
  </div>
</a>
