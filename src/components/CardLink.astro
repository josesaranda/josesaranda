---
interface Props {
  link: string;
  ariaLabel: string;
}

const { link, ariaLabel } = Astro.props;
---

<a
  class="group fade-target block"
  href={link}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={ariaLabel}
>
  <div
    class="max-w-screen-2xl mx-auto px-4 md:px-16 py-10 lg:py-14 border-t border-gray-200 dark:border-gray-700 group-hover:border-blue-900 dark:group-hover:border-blue-400 transition-colors duration-300 relative"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="absolute top-3 right-3 md:top-6 md:right-6 lg:top-8 lg:right-16 text-gray-300 dark:text-gray-600 group-hover:text-blue-900 dark:group-hover:text-blue-400 opacity-0 group-hover:opacity-100 transition-all duration-300"
    >
      <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
      <polyline points="15 3 21 3 21 9"></polyline>
      <line x1="10" y1="14" x2="21" y2="3"></line>
    </svg>
    <slot />
  </div>
</a>
