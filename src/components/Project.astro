---
import CardLink from "./CardLink.astro";

interface Props {
  name: string;
  edition: string;
  description: string;
  type: string;
  link: string;
}

const { name, edition, description, type, link } = Astro.props;
---

<CardLink link={link} ariaLabel={`${name} ${edition}: ${description}`}>
  <h3
    class="text-gray-800 dark:text-white text-2xl lg:text-4xl font-serif leading-tight group-hover:text-blue-900 dark:group-hover:text-blue-400 transition-colors duration-300 mb-4"
  >
    {name}
  </h3>
  <div class="flex items-center gap-2 mb-4">
    <span
      class="font-sans text-sm lg:text-base font-semibold tracking-wide text-blue-900 dark:text-blue-400 bg-blue-50 dark:bg-blue-900/30 px-2.5 py-0.5 rounded"
    >
      {edition}
    </span>
    <span
      class="text-xs lg:text-sm font-sans bg-gray-100 dark:bg-gray-800 group-hover:bg-blue-50 dark:group-hover:bg-blue-900/30 text-gray-500 dark:text-gray-400 group-hover:text-gray-700 dark:group-hover:text-gray-200 px-2.5 py-1 rounded transition-colors duration-300"
    >
      {type}
    </span>
  </div>
  <p
    class="text-gray-800 dark:text-gray-200 text-base lg:text-lg font-sans leading-relaxed"
  >
    {description}
  </p>
</CardLink>
